NODE_ENV=local

# `bun run dev` serves named portless `.localhost` URLs (branch-prefixed in a worktree); `PORTLESS=0` uses the plain localhost ports below.

# -------------------- Server variables --------------------

HONO_APP_URL=http://localhost:4000
HONO_TRUSTED_ORIGINS=http://localhost:3000
HONO_RATE_LIMIT=60 # allow 60 req/min (default)
HONO_RATE_LIMIT_WINDOW_MS=60000 # 1 minute (default)

# IMDb scores come from IMDb's daily datasets, imported into Postgres by `bun run imdb:sync` (nightly in CI); override the origin to point the job at a mock during tests.
IMDB_DATASETS_URL=https://datasets.imdbws.com

# Generate using `bunx pglaunch -k`
POSTGRES_URL=

# -------------------- Client variables --------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: PostHog Analytics (https://zerostarter.dev/docs/manage/analytics)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Optional: User feedback (https://zerostarter.dev/docs/manage/analytics)
NEXT_PUBLIC_USERJOT_URL=

# Baked into the extension build as its default API origin (and its host permission); the extension options page can override the URL at runtime, e.g. with the portless api URL.
WXT_PUBLIC_API_URL=http://localhost:4000
